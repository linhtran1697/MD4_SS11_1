{
  "info": {
    "name": "HRM JWT Login",
    "description": "Login with AuthenticationManager, receive JWT and call protected employees API. Demo credentials: admin / Admin123!. Run 01 before 02.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "username",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Admin123!",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Login (200, save JWT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.test(\"Required JWT response\", function () {",
              "    pm.expect(Object.keys(data).sort()).to.eql([\"accessToken\", \"type\", \"username\"].sort());",
              "    pm.expect(data.type).to.eql(\"Bearer\");",
              "    pm.expect(data.username).to.eql(pm.collectionVariables.get(\"username\"));",
              "    pm.expect(data.accessToken.split(\".\").length).to.eql(3);",
              "  });",
              "  pm.collectionVariables.set(\"accessToken\", data.accessToken);",
              "} else { pm.collectionVariables.unset(\"accessToken\"); }"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "02 - Employees with JWT (200)",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "employees"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Exactly three original employees\", function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data.length).to.eql(3);",
              "  pm.expect(data[0].fullName).to.eql(\"Nguyễn Văn An\");",
              "  pm.expect(data[0].salary).to.eql(18000000);",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "03 - Employees without token (401)",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "employees"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"JSON error\", function () {",
              "  pm.expect(pm.response.json().status).to.eql(401);",
              "  pm.expect(pm.response.json()).to.not.have.property(\"accessToken\");",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "04 - Wrong login password (401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong-password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"JSON error\", function () {",
              "  pm.expect(pm.response.json().status).to.eql(401);",
              "  pm.expect(pm.response.json()).to.not.have.property(\"accessToken\");",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "05 - Missing credentials (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"JSON error\", function () {",
              "  pm.expect(pm.response.json().status).to.eql(400);",
              "  pm.expect(pm.response.json()).to.not.have.property(\"accessToken\");",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    },
    {
      "name": "06 - Invalid bearer token (401)",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "not-a-valid-jwt",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "employees"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
              "pm.test(\"JSON error\", function () {",
              "  pm.expect(pm.response.json().status).to.eql(401);",
              "  pm.expect(pm.response.json()).to.not.have.property(\"accessToken\");",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableCookies": true
      }
    }
  ]
}
